#!/bin/sh
# Installs what the shell setup needs. Re-runs only when this file changes.
SUDO=; [ "$(id -u)" = 0 ] || SUDO="sudo${CASAMIA_NONINTERACTIVE:+ -n}"
{{- if eq .chezmoi.os "darwin" }}
# Homebrew refuses to run as root; the font is per Mac, installed from your own account
if [ "$(id -u)" != 0 ] && command -v brew >/dev/null; then
  brew list --cask font-meslo-lg-nerd-font >/dev/null 2>&1 || brew install --cask font-meslo-lg-nerd-font
fi
{{- else if stat "/opt/bin/opkg" }}
for p in zsh git git-http curl ca-certificates terminfo screen; do
  /opt/bin/opkg list-installed | grep -q "^$p " || $SUDO env PATH=/opt/bin:/opt/sbin:$PATH /opt/bin/opkg install "$p"
done
{{- else if lookPath "apt-get" }}
command -v zsh >/dev/null || $SUDO apt-get install -y zsh
[ "$(basename "$SHELL")" = zsh ] || echo "Run: chsh -s $(command -v zsh)"
{{- else if lookPath "dnf" }}
command -v zsh >/dev/null || $SUDO dnf install -y zsh
[ "$(basename "$SHELL")" = zsh ] || echo "Run: chsh -s $(command -v zsh)"
{{- end }}
