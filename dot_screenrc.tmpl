# ~/.screenrc — managed by cjt-casamia (edit with: cjt-casamia edit ~/.screenrc)
# Status bar in the same muted palette as the zsh prompt. No icons: screen miscounts their width and the line wraps.
{{- $v := output "sh" "-c" "screen -v 2>&1 || true" }}

startup_message off
defutf8 on
utf8 on on
altscreen on
defscrollback 20000
vbell off
term xterm-256color   # mc, vim etc. then see 256 colours
termcapinfo xterm* 'Co#256:AB=\E[48;5;%dm:AF=\E[38;5;%dm'
defbce on

# Complementary info, refreshed every 60 s (the prompt already shows load, RAM, clock)
backtick 1 60 60 cjt-statusinfo uptime
backtick 2 60 60 cjt-statusinfo ip

hardstatus alwayslastline
{{- if regexMatch "[Vv]ersion [5-9]" $v }}
# screen 5+: 256 colours as fg;bg
hardstatus string '%{180;236} %H %{250;235} %-w%{152;23} %n %t %{250;235}%+w%=%{243;235}up %{109;235}%1` %{243;235}· ip %{140;235}%2` %{243;235}· %{245;235}%D %d %M %{250;235}%c '
caption string '%?%F%{152;23}%:%{245;236}%? %n %t %{-}'
{{- else }}
# screen 4.x: 8 colours, no icons (it miscounts their width and the line wraps)
hardstatus string '%{= kY} %H %{= kw} %-w%{= bW} %n %t %{= kw}%+w%=%{= kc}up %1` %{= km}%2` %{= kw}%D %d %M %c '
caption string '%?%F%{= bW}%:%{= kw}%? %n %t '
{{- end }}

# Ctrl-a | and Ctrl-a - split; Ctrl-a Tab moves between regions
bind | split -v
bind - split
