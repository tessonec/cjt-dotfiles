#!/bin/sh
# cjt-casamia — the same shell setup on every machine (chezmoi + git).
#
# New machine (macOS, Linux, Asustor/Synology with Entware):
#   curl -fsSL https://raw.githubusercontent.com/tessonec/cjt-dotfiles/main/dot_local/bin/executable_cjt-casamia | sh -s init
#
# Commands:
#   init              install chezmoi and apply the dotfiles for the current user
#                     (sudo cjt-casamia init  does the same for root)
#   pull              fetch and apply the latest version
#   push [message]    collect local edits, commit, push
#   sync [message]    push + pull in one go
#   add FILE...       start managing more files (e.g. ~/.tmux.conf ~/.vimrc ~/.config/mc/ini)
#   edit FILE         edit a managed file (templates too) and apply
#   status            what differs locally / what is unpushed
#   diff              show what 'apply' would change
#   apply             apply the local copy of the repo (after moving old stuff aside)
#   reset             throw away local changes and match GitHub exactly
#   import FILE.tgz   unpack a new version of the repo, commit, push and apply
#   auto [on|off]     background pull at shell start, at most every 12 h (default: on)
#
# You never need to run chezmoi or git yourself.
set -e

# Under sudo, HOME can still point at the calling user's home: always use root's own
if [ "$(id -u)" = 0 ] && [ -n "$SUDO_USER" ]; then
  HOME=$( (getent passwd root 2>/dev/null || grep '^root:' /etc/passwd) | cut -d: -f6 )
  HOME=${HOME:-/root}; export HOME
fi
[ -d /opt/bin ] && case ":$PATH:" in *:/opt/bin:*) ;; *) PATH=/opt/bin:/opt/sbin:$PATH ;; esac
PATH=$HOME/.local/bin:$PATH; export PATH
GIT_TERMINAL_PROMPT=0; export GIT_TERMINAL_PROMPT   # never ask for a GitHub password
# Own temp dir: some servers have a tiny or full /tmp
TMPDIR=${XDG_CACHE_HOME:-$HOME/.cache}/cjt-casamia/tmp; mkdir -p "$TMPDIR"; export TMPDIR

REPO_SSH=${CASAMIA_REPO_SSH:-git@github.com:tessonec/cjt-dotfiles.git}
REPO_HTTPS=${CASAMIA_REPO_HTTPS:-https://github.com/tessonec/cjt-dotfiles.git}
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}
STAMP=$CACHE/cjt-casamia.last
OFF=$CACHE/cjt-casamia.off

say()  { printf '\033[38;5;108m▸\033[0m %s\n' "$*"; }
warn() { printf '\033[38;5;179m!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[38;5;167m✗\033[0m %s\n' "$*" >&2; exit 1; }

cz() {
  command -v chezmoi >/dev/null 2>&1 || die "chezmoi not found — run: cjt-casamia init"
  chezmoi --no-pager "$@"
}

install_chezmoi() {
  command -v chezmoi >/dev/null 2>&1 && return 0
  if [ "$(uname)" = Darwin ] && command -v brew >/dev/null 2>&1 && [ "$(id -u)" != 0 ]; then
    say "Installing chezmoi (Homebrew)"; brew install chezmoi
  else
    command -v curl >/dev/null 2>&1 || die "curl is needed"
    say "Installing chezmoi into $HOME/.local/bin"
    sh -c "$(curl -fsLS get.chezmoi.io)" -- -b "$HOME/.local/bin"
  fi
}

pick_repo() {
  # SSH if this account can reach GitHub with a key (can push), else read-only HTTPS
  if [ "$(id -u)" != 0 ] && command -v git >/dev/null 2>&1 &&
     GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=5" git ls-remote "$REPO_SSH" >/dev/null 2>&1; then
    echo "$REPO_SSH"
  else
    echo "$REPO_HTTPS"
  fi
}

# Make an existing machine safe to take over: back up old configs, keep conda,
# and move away oh-my-zsh/theme/plugin folders that are not git clones
prepare_home() {
  BK=$HOME/.local/state/cjt-casamia/backup-$(date +%Y%m%d-%H%M%S)
  backup() { [ -e "$1" ] || return 0; mkdir -p "$BK"; mv "$1" "$BK/"; warn "Moved old $1 to $BK/"; }

  # conda init block -> ~/.zshrc.local (not managed, loaded at the end of .zshrc)
  if grep -q '>>> conda initialize >>>' "$HOME/.zshrc" 2>/dev/null &&
     ! grep -q '>>> conda initialize >>>' "$HOME/.zshrc.local" 2>/dev/null; then
    awk '/>>> conda initialize >>>/,/<<< conda initialize <<</' "$HOME/.zshrc" >> "$HOME/.zshrc.local"
    say "Kept your conda setup in ~/.zshrc.local"
    command -v conda >/dev/null 2>&1 && conda config --set changeps1 False >/dev/null 2>&1 || true
  fi

  # first takeover only: keep copies of the old hand-made configs
  if [ ! -d "$(cz source-path 2>/dev/null)/.git" ]; then
    for f in .zshrc .p10k.zsh; do
      [ -f "$HOME/$f" ] && { mkdir -p "$BK"; cp "$HOME/$f" "$BK/"; }
    done
    [ -d "$BK" ] && say "Copies of your old configs are in $BK/"
  fi

  # chezmoi updates these with git pull, so they must be git clones (or absent)
  for d in .oh-my-zsh/custom/themes/powerlevel10k \
           .oh-my-zsh/custom/plugins/zsh-autosuggestions \
           .oh-my-zsh/custom/plugins/zsh-syntax-highlighting \
           .oh-my-zsh; do
    [ -d "$HOME/$d" ] && [ ! -d "$HOME/$d/.git" ] && backup "$HOME/$d"
  done
  return 0
}

# Linux servers: make logins land in zsh without chsh (works with LDAP accounts too)
ensure_login_zsh() {
  # macOS root defaults to /bin/sh: switch it to zsh so 'sudo -i' gets the prompt
  if [ "$(uname)" = Darwin ]; then
    if [ "$(id -u)" = 0 ] && ! dscl . -read /Users/root UserShell 2>/dev/null | grep -q zsh; then
      chsh -s /bin/zsh root >/dev/null 2>&1 && say "root's shell is now zsh"
    fi
    return 0
  fi
  [ "$(uname)" = Linux ] && [ ! -x /opt/bin/opkg ] || return 0
  if ! command -v zsh >/dev/null 2>&1; then
    if command -v apt-get >/dev/null 2>&1 && { [ "$(id -u)" = 0 ] || sudo -n true 2>/dev/null; }; then
      say "Installing zsh"; $( [ "$(id -u)" = 0 ] || echo sudo ) apt-get install -y -qq zsh >/dev/null
    else
      warn "zsh is not installed here and I cannot install it — ask the admins for 'zsh'"; return 0
    fi
  fi
  case $(basename "${SHELL:-}") in zsh) return 0 ;; esac
  line='[ -x "$(command -v zsh)" ] && [ -z "$ZSH_VERSION" ] && [ -t 1 ] && exec zsh -l  # cjt-casamia'
  if [ -f "$HOME/.bash_profile" ]; then f=$HOME/.bash_profile
  elif [ -f "$HOME/.bash_login" ]; then f=$HOME/.bash_login
  else f=$HOME/.profile; fi
  grep -q 'cjt-casamia' "$f" 2>/dev/null || { printf '\n%s\n' "$line" >> "$f"; say "Logins now start zsh (via $(basename "$f"))"; }
}

# Files changed on this machine since the last apply (first status column)
local_edits() { chezmoi --no-pager status 2>/dev/null | awk 'substr($0,1,1)!=" " {print substr($0,4)}'; }

cmd_init() {
  if [ -d /volume1 ] && [ ! -x /opt/bin/opkg ]; then
    die "This NAS has no Entware yet. Install Entware first, then re-run."
  fi
  command -v git >/dev/null 2>&1 || die "git is needed (NAS: opkg install git git-http; Mac: xcode-select --install)"
  cd "$HOME"
  install_chezmoi
  prepare_home
  if [ -d "$(cz source-path 2>/dev/null)/.git" ]; then
    say "Already initialised — refreshing config and updating"
    cz init                # regenerates ~/.config/chezmoi/chezmoi.toml (no pager, etc.)
    cz update --force
  else
    repo=$(pick_repo)
    say "Applying dotfiles from $repo as $(id -un)@$(hostname)"
    cz init --apply --force "$repo"
  fi
  ensure_login_zsh
  mkdir -p "$CACHE"; touch "$STAMP"
  if [ "$(id -u)" = 0 ]; then say "Done for root. Use: sudo -i"
  else say "Done. Start a new shell; for root: sudo cjt-casamia init"; fi
}

cmd_pull() {
  if [ -n "$(local_edits)" ]; then
    warn "Local edits not yet pushed:"; local_edits
    warn "Run 'cjt-casamia push' first (or 'cjt-casamia sync')."; exit 1
  fi
  say "Pulling"; cz update --force
  mkdir -p "$CACHE"; touch "$STAMP"
}

cmd_push() {
  msg=${1:-"$(id -un)@$(hostname): $(date '+%Y-%m-%d %H:%M')"}
  # take over only the files edited on this machine (never overwrite newer repo files)
  for f in $(local_edits); do
    case $f in
      .zshrc|.profile) warn "~/$f is a template: change it with 'cjt-casamia edit ~/$f'" ;;
      *) cz add "$HOME/$f" && say "Took over ~/$f" ;;
    esac
  done
  cz git -- add -A
  if git -C "$(cz source-path)" diff --cached --quiet; then say "Nothing to commit"
  else cz git -- commit -q -m "$msg"; say "Committed: $msg"; fi
  src=$(cz source-path)
  git -C "$src" pull --rebase -q || die "Merge conflict — resolve in: $src"
  if [ "$(git -C "$src" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)" = 0 ]; then
    say "Nothing to push"; return 0
  fi
  case $(git -C "$src" remote get-url origin) in
    https:*) die "This machine can only pull (no GitHub SSH key here). Make the change on your Mac, or add an SSH key." ;;
  esac
  git -C "$src" push -q || die "Push failed"
  say "Pushed"
}

cmd_sync()   { cmd_push "$@"; cz apply --force; mkdir -p "$CACHE"; touch "$STAMP"; say "In sync"; }
cmd_add()    { [ $# -gt 0 ] || die "usage: cjt-casamia add FILE..."; cz add "$@"; say "Now managed: $* — run 'cjt-casamia push'"; }
cmd_edit()   { [ $# -gt 0 ] || die "usage: cjt-casamia edit FILE"; cz edit --apply "$@"; }
cmd_status() {
  echo "Local changes not in the repo:"; cz status || true
  echo "Repo:"; cz git -- status -sb
}

# Throw away anything local and match GitHub exactly (repo copy and the managed files)
cmd_reset() {
  src=$(cz source-path)
  git -C "$src" rebase --abort >/dev/null 2>&1 || true
  git -C "$src" merge --abort  >/dev/null 2>&1 || true
  git -C "$src" fetch -q origin && git -C "$src" reset -q --hard origin/main && git -C "$src" clean -qfd
  CASAMIA_NONINTERACTIVE= cz apply --force
  say "This machine now matches GitHub"
}

cmd_diff()  { cz diff; }
cmd_apply() { prepare_home; cz apply --force; say "Applied"; }

cmd_import() {
  f=$1; [ -f "$f" ] || die "usage: cjt-casamia import FILE.tar.gz"
  case $f in /*) ;; *) f=$PWD/$f ;; esac
  src=$(cz source-path 2>/dev/null) || die "Run 'cjt-casamia init' first"
  [ -d "$src/.git" ] || die "Run 'cjt-casamia init' first"
  tar xzf "$f" -C "$src"
  cz git -- add -A
  if git -C "$(cz source-path)" diff --cached --quiet; then say "Repo already up to date"
  else
    cz git -- commit -q -m "import $(basename "$f")"; say "Committed"
    cz git -- pull --rebase -q && cz git -- push -q && say "Pushed" || warn "Not pushed (read-only clone?)"
  fi
  cmd_apply
}

cmd_auto() {
  mkdir -p "$CACHE"
  case $1 in
    on)  rm -f "$OFF"; say "Auto-pull: on" ;;
    off) touch "$OFF"; say "Auto-pull: off" ;;
    *)   [ -e "$OFF" ] && echo off || echo on ;;
  esac
}

# Run in the background from .zshrc at every shell start:
#  - on a machine that can push (SSH remote), publish repo changes made there right away
#  - pull at most every 12 h
#  - apply only when nothing was edited locally
cmd_autopull() {
  [ -e "$OFF" ] && exit 0
  command -v chezmoi >/dev/null 2>&1 || exit 0
  src=$(chezmoi --no-pager source-path 2>/dev/null) || exit 0
  mkdir -p "$CACHE"; apply=
  if [ -n "$(git -C "$src" status --porcelain 2>/dev/null)" ] &&
     git -C "$src" remote get-url origin 2>/dev/null | grep -q '^git@'; then
    ( cmd_push "auto: $(id -un)@$(hostname) $(date '+%Y-%m-%d %H:%M')" ) >/dev/null 2>&1 && apply=1
  fi
  if [ -z "$(find "$STAMP" -mmin -720 2>/dev/null)" ]; then
    touch "$STAMP"
    git -C "$src" pull --ff-only -q >/dev/null 2>&1 && apply=1
  fi
  [ -n "$apply" ] && [ -z "$(local_edits)" ] &&
    CASAMIA_NONINTERACTIVE=1 chezmoi --no-pager apply --force --no-tty >/dev/null 2>&1
  exit 0
}

case ${1:-help} in
  init|install) shift; cmd_init "$@" ;;
  pull|update)  cmd_pull ;;
  push)         shift; cmd_push "$@" ;;
  sync)         shift; cmd_sync "$@" ;;
  add)          shift; cmd_add "$@" ;;
  edit)         shift; cmd_edit "$@" ;;
  status|st)    cmd_status ;;
  reset)        cmd_reset ;;
  diff)         cmd_diff ;;
  apply)        cmd_apply ;;
  import)       shift; cmd_import "$@" ;;
  auto)         shift; cmd_auto "$@" ;;
  autopull)     cmd_autopull ;;
  *) sed -n '2,23p' "$0" 2>/dev/null | sed 's/^# \{0,1\}//' ;;
esac
